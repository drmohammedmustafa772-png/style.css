body {
  font-family: 'Segoe UI', Arial, sans-serif;
  margin: 0;
  padding: 0;
  background: linear-gradient(135deg, #1f1c2c, #928dab);
  color: #fff;
}

/* رأس الصفحة */
header {
  text-align: center;
  padding: 60px 20px;
  background: rgba(0, 0, 0, 0.4);
}

header h1 {
  font-size: 3em;
  margin-bottom: 10px;
  color: #00c6ff;
}

header p {
  font-size: 1.2em;
  max-width: 600px;
  margin: auto;
}

/* قسم المميزات */
section {
  padding: 50px 20px;
}

section h2 {
  font-size: 2em;
  margin-bottom: 30px;
  color: #ffd700;
}

/* بطاقات المميزات */
.features {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20px;
}

.card {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  padding: 20px;
  width: 250px;
  transition: transform 0.3s ease, background 0.3s ease;
}

.card:hover {
  transform: translateY(-10px);
  background: rgba(255, 255, 255, 0.2);
}

.card h3 {
  margin-bottom: 10px;
  color: #00ffcc;
}

/* تذييل الصفحة */
footer {
  text-align: center;
  background: #111;
  padding: 20px;
  margin-top: 40px;
  font-size: 0.9em;
}
